{
  "name": "@likith99/react-native-adaptive-liquid-glass",
  "version": "0.1.4",
  "description": "Native iOS Liquid Glass surfaces and controls with standard Android counterparts.",
  "license": "MIT",
  "author": "Likith Kanneganti",
  "homepage": "https://github.com/likith099/liquedGlassRecreate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/likith099/liquedGlassRecreate.git",
    "directory": "packages/liquid-glass"
  },
  "bugs": {
    "url": "https://github.com/likith099/liquedGlassRecreate/issues"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "liquid-glass",
    "glass",
    "uikit",
    "swiftui",
    "material",
    "fabric",
    "new-architecture",
    "tabs",
    "toolbar",
    "menu",
    "accessibility"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "ios",
    "android",
    "!android/build",
    "!android/.gradle",
    "AdaptiveLiquidGlass.podspec",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0"
  },
  "codegenConfig": {
    "name": "AdaptiveLiquidGlassSpec",
    "type": "components",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.adaptiveglass"
    },
    "ios": {
      "componentProvider": {
        "ALGSurface": "ALGSurfaceComponentView",
        "ALGButton": "ALGButtonComponentView",
        "ALGSegmented": "ALGSegmentedComponentView",
        "ALGSlider": "ALGSliderComponentView",
        "ALGActionCluster": "ALGActionClusterComponentView",
        "ALGMenu": "ALGMenuComponentView",
        "ALGTabs": "ALGTabsComponentView",
        "ALGScrollEdge": "ALGScrollEdgeComponentView",
        "ALGSearchField": "ALGSearchFieldComponentView",
        "ALGExpandingTabs": "ALGExpandingTabsComponentView",
        "ALGSymbol": "ALGSymbolComponentView"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "react-native-builder-bob": "^0.43.1"
  },
  "scripts": {
    "build": "bob build",
    "prepack": "bob build"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
